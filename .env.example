# Copy to .env and restrict file permissions. Never commit real values.
SQLITE_PATH=/data/stock-briefing.db
KAKAO_SKILL_SECRET=replace-with-long-random-route-secret
KAKAO_ALLOWED_USER_IDS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# Enable only on one API instance, after stopping any old Telegram poller.
TELEGRAM_POLLING_ENABLED=0
# HTTPS origin/path served by Caddy for the one-time broker registration screen.
PUBLIC_BASE_URL=https://replace-with-your-domain
# Bind a separate protected directory to /run/stock-briefing-secrets (see README).
MASTER_KEY_FILE=/run/stock-briefing-secrets/master.key
# Platform deployments can set SECRET:MASTER_KEY to the existing key instead.
BROKER_SECRETS_DIR=../stock-briefing-secrets
# Optional local provisioning instead of the one-time registration form.
# If set, disconnect requires clearing these variables and restarting containers.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ENVIRONMENT=live

# Personal dashboard at /stock-briefing/ (disabled unless password is at least 12 characters).
# Use a unique random password. HTTP on private IPs is enabled for WireGuard access;
# restrict Caddy's TCP/8081 listener to WireGuard peers with the host firewall.
DASHBOARD_ALLOW_HTTP_PRIVATE=1
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=


# Production backend is enforced by Compose; SQLite remains for offline migration.
# API scheduling is enabled by compose.scheduler.yaml after verified import.
DAILY_SCHEDULER_ENABLED=0
# A secret file is generated on the host by scripts/migrate-postgres.sh.
# Never commit its contents or change it after PostgreSQL initialization.
